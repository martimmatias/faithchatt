# Copy the values below into your root .env (do not commit real values).
# See test/e2e/README.md for how to build the test server these IDs point to.

# Same variables the bot itself uses (utils/mongo.js, index.js) - point these
# at your test bot/database, never at production.
TOKEN=
MONGO_URL=

# Test server the jail lifecycle test is allowed to mutate.
E2E_GUILD_ID=

# A throwaway account (a second bot works well) that is already a member of
# the test server. The suite repeatedly jails/unjails it.
E2E_TARGET_USER_ID=

# Roles that must exist on the test server (any IDs - they don't need to
# match production's).
E2E_ROLE_MEMBER_ID=
E2E_ROLE_MUTED_ID=
E2E_ROLE_MODERATOR_ID=
E2E_ROLE_UNVERIFIED_ID=

# Category jail tickets get created under.
E2E_CATEGORY_JAIL_ID=

# Log channels the jail commands post to.
E2E_CHANNEL_MOD_LOG_ID=
E2E_CHANNEL_JAIL_LOG_ID=

# Optional: only needed to exercise the "can't /closejail the rules channel"
# guard. Leave unset otherwise.
E2E_CHANNEL_JAILED_RULES_ID=
